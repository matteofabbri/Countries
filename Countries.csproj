<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Countries</AssemblyName>

    <!-- Multi-targeting -->
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>

    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <!-- Disable auto-generation — we let the csproj metadata drive NuGet,
         but suppress the per-TFM attribute files that cause CS0579 duplicates -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- NuGet metadata -->
    <PackageId>Countries</PackageId>
    <Version>1.0.0</Version>
    <Authors>Matteo Fabbri</Authors>
    <Company>Matteo Fabbri</Company>
    <Copyright>Matteo Fabbri 2015</Copyright>
    <Description>Complete ISO‑3166‑1 dataset

Strongly‑typed country model

ISO2, ISO3, numeric codes, CIOC

Official name, common name, alternative spellings

Capital, region, subregion, TLD, calling codes

Zero dependencies, zero external API calls

High‑performance fuzzy search with accent removal and typo tolerance

Multi‑targeting: .NET Standard 2.0, .NET 6, .NET 8, .NET 10

Suitable for libraries, backend services, validation layers, and data processing</Description>
    <AssemblyTitle>Countries</AssemblyTitle>
    <Product>Countries</Product>
    <PackageTags>countries;country;iso;iso3166;iso2;iso3;country-codes;geography;geodata;region;subregion;tld;calling-codes;fuzzy-search;normalization;internationalization;globalization;dataset;lookup;validation</PackageTags>

    <!-- Repository info -->
    <RepositoryUrl>https://github.com/matteofabbri/Countries</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- README -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Deterministic build -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <!-- Auto-generate NuGet package -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- Symbol package -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/matteofabbri/Countries</PackageProjectUrl>
    <PackAsTool>False</PackAsTool>
    <AssemblyVersion>3.0.</AssemblyVersion>
    <FileVersion>3.0</FileVersion>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exclude test project sources from this library's compilation -->
  <ItemGroup>
    <Compile Remove="Countries.Tests\**" />
    <None Remove="Countries.Tests\**" />
    <EmbeddedResource Remove="Countries.Tests\**" />
  </ItemGroup>

</Project>
